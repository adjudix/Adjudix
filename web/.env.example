# Form submissions are emailed to the Secretariat. Copy this file to
# .env.local (and set the same variables on the host) to enable sending.
#
# Using the principal Gmail account: turn on 2-Step Verification, then create
# an App Password (Google Account > Security > App passwords) and paste it
# below. Never use the account's normal password here.
SMTP_USER=adjudix@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_TO=secretariat@adjudixadr.com
# MAIL_FROM=adjudix@gmail.com
