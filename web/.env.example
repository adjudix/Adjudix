# Form submissions are emailed to the Secretariat through Brevo. Copy this
# file to .env.local (and set the same variables in Vercel, on every project
# that serves the site) to enable sending.
#
# Brevo > SMTP & API > API keys > Generate a new API key.
BREVO_API_KEY=
# The "from" address. It must be a verified sender in Brevo
# (Brevo > Senders, Domains & Dedicated IPs > Senders).
# MAIL_FROM=secretariat@adjudixadr.com
# Where submissions are delivered.
# MAIL_TO=secretariat@adjudixadr.com
